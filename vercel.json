{
  "services": {
    "frontend": {
      "root": "./frontend",
      "framework": "vite"
    },
    "backend": {
      "root": "./backend"
    }
  },

  
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ]
}
